# Database (SQLite for local dev, PostgreSQL for production/docker)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reviewrewards?schema=public"

# Search Provider: "serpapi", "google", "brave", or "mock"
SEARCH_PROVIDER="serpapi"

# SerpAPI Configuration
SERPAPI_API_KEY=""
SERPAPI_TBS="qdr:m"
MAX_SEARCHES_PER_RUN="40"

# Optional alternative search providers
SEARCH_API_KEY=""
GOOGLE_CSE_ID=""

# Optional LLM Extraction fallback (Claude 3 Haiku / 3.5 Sonnet)
ANTHROPIC_API_KEY=""

# Admin API security token
ADMIN_TOKEN="admin_secret_token_123"

# Crawler configuration
CRAWLER_USER_AGENT="ReviewRewardsBot/1.0 (+https://reviewrewards-tracker.local/bot; contact@reviewrewards.local)"
CRAWLER_DOMAIN_DELAY_MS="2000"
CRAWLER_MAX_RETRIES="3"
CRAWLER_TIMEOUT_MS="15000"
USE_PLAYWRIGHT_FALLBACK="false"

# Server Port
PORT=3000
